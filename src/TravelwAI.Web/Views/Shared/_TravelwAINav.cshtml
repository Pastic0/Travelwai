@model string
@{
    var activeNav = (Model ?? string.Empty).ToLowerInvariant();
    var travelNavActive = activeNav == "schedule" || activeNav == "plans";
    var exploreNavActive = activeNav == "messaging" || activeNav == "posts" || activeNav == "tours" || activeNav == "location-analysis";
}
<header class="site-header landing-nav-style">
  <div class="logo">
    <img src="/logo/travelwai-icon.webp?v=2026-07-26-brand-icon-v2" alt="TravelwAI Logo" />
    <span class="logo-text"><a href="/home">TravelwAI</a></span>
  </div>
  <nav>
    <ul class="main-nav">
      <li class="nav-dropdown">
        <button class="nav-menu-trigger @(travelNavActive ? "current active" : null)" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="travelNavDropdown">
          <span>Du lịch</span>
        </button>
        <div class="nav-dropdown-menu" id="travelNavDropdown" role="menu">
          <a href="/schedule" class="@(activeNav == "schedule" ? "current active" : null)" aria-current="@(activeNav == "schedule" ? "page" : null)">Lịch trình</a>
          <a href="/plans" class="@(activeNav == "plans" ? "current active" : null)" aria-current="@(activeNav == "plans" ? "page" : null)">Kế hoạch</a>
        </div>
      </li>
      <li><a href="/provinces" class="@(activeNav == "provinces" ? "current active" : null)" aria-current="@(activeNav == "provinces" ? "page" : null)">Bản đồ Việt Nam</a></li>
      <li class="nav-dropdown">
        <button class="nav-menu-trigger @(exploreNavActive ? "current active" : null)" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="exploreNavDropdown">
          <span>Khám phá</span>
        </button>
        <div class="nav-dropdown-menu" id="exploreNavDropdown" role="menu">
          <a href="/messaging" class="@(activeNav == "messaging" ? "current active" : null)" aria-current="@(activeNav == "messaging" ? "page" : null)">Nhắn tin</a>
          <a href="/posts" class="@(activeNav == "posts" ? "current active" : null)" aria-current="@(activeNav == "posts" ? "page" : null)">Bài viết</a>
          <a href="/tours" class="@(activeNav == "tours" ? "current active" : null)" aria-current="@(activeNav == "tours" ? "page" : null)">Tour du lịch</a>
          <a href="/location-analysis" class="@(activeNav == "location-analysis" ? "current active" : null)" aria-current="@(activeNav == "location-analysis" ? "page" : null)">Phân tích địa danh</a>
        </div>
      </li>
    </ul>
  </nav>
  <div class="contact-icons">
    <a id="roleDashboardIcon" href="/admin" class="icon role-dashboard-icon" hidden style="display:none" aria-label="Trang quản trị">
      <span data-interface-icon="layout-dashboard"></span>
    </a>
    <a href="#feedback-panel" id="feedbackIconContainer" class="icon phone feedback-icon-container" data-feedback-panel-trigger onclick="return openFeedbackPanel(event)" aria-label="Phản hồi" title="Phản hồi">
      <span data-interface-icon="message-square"></span>
    </a>
    <a href="#notification-panel" id="notificationIconContainer" class="notification-icon-container icon" data-notification-panel-trigger onclick="return openNotificationPanel(event)" aria-label="Thông báo">
      <span data-interface-icon="bell"></span>
      <span class="notification-badge" id="notificationBadge" style="display:none">0</span>
    </a>
    <a href="/cart" class="icon cart @(activeNav == "cart" ? "current active" : null)" aria-current="@(activeNav == "cart" ? "page" : null)" aria-label="Giỏ hàng" title="Giỏ hàng">
      <span data-interface-icon="shopping-cart"></span>
    </a>
    <a id="profileIcon" href="/profile" class="icon profile @(activeNav == "profile" ? "current active" : null)" aria-current="@(activeNav == "profile" ? "page" : null)" aria-label="Hồ sơ" title="Hồ sơ">
      <span data-interface-icon="user"></span>
    </a>
  </div>
</header>

<script>
(function () {
  function readCookie(name) {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return decodeURIComponent(parts.pop().split(';').shift() || '');
    return '';
  }

  function normalizeRole(value) {
    return String(value || '').trim().toLowerCase().replace(/[_-]+/g, ' ');
  }

  function showRoleButton(role) {
    const button = document.getElementById('roleDashboardIcon');
    if (!button) return;

    const normalized = normalizeRole(role);
    button.hidden = true;
    button.style.setProperty('display', 'none', 'important');
    button.removeAttribute('href');

    if (normalized === 'admin') {
      button.href = '/admin';
      button.title = 'Trang Admin';
      button.setAttribute('aria-label', 'Trang Admin');
      button.hidden = false;
      button.style.setProperty('display', 'inline-flex', 'important');
      return;
    }

    if (normalized === 'sales' || normalized === 'tour sales' || normalized === 'toursales') {
      button.href = '/business';
      button.title = 'Business';
      button.setAttribute('aria-label', 'Business');
      button.hidden = false;
      button.style.setProperty('display', 'inline-flex', 'important');
      return;
    }


    if (normalized === 'company' || normalized === 'business') {
      button.href = '/business';
      button.title = 'Business';
      button.setAttribute('aria-label', 'Business');
      button.hidden = false;
      button.style.setProperty('display', 'inline-flex', 'important');
    }

  }

  function setupNavDropdowns() {
    const dropdowns = Array.from(document.querySelectorAll('.main-nav .nav-dropdown'));
    if (!dropdowns.length) return;

    function closeDropdown(dropdown) {
      dropdown.classList.remove('is-open');
      dropdown.querySelector(':scope > .nav-menu-trigger')?.setAttribute('aria-expanded', 'false');
    }

    function closeAll(except) {
      dropdowns.forEach(function (dropdown) {
        if (dropdown !== except) closeDropdown(dropdown);
      });
    }

    dropdowns.forEach(function (dropdown) {
      const trigger = dropdown.querySelector(':scope > .nav-menu-trigger');
      if (!trigger) return;
      trigger.addEventListener('click', function (event) {
        event.preventDefault();
        const shouldOpen = !dropdown.classList.contains('is-open');
        closeAll(dropdown);
        dropdown.classList.toggle('is-open', shouldOpen);
        trigger.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
      });
    });

    document.addEventListener('click', function (event) {
      if (!event.target.closest('.main-nav .nav-dropdown')) closeAll();
    });

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      closeAll();
      document.querySelector('.main-nav .nav-menu-trigger:focus')?.blur();
    });
  }

  async function syncRoleDashboardIcon() {
    const token = localStorage.getItem('idToken') || sessionStorage.getItem('idToken') || readCookie('TravelwAIAuth');
    showRoleButton('Free');

    if (!token) {
      localStorage.removeItem('userRole');
      return;
    }

    try {
      const response = await fetch('/api/verify-token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ idToken: token })
      });
      const result = await response.json().catch(function () { return {}; });
      const role = result && result.user ? result.user.role : '';
      localStorage.setItem('userRole', role || 'Free');
      showRoleButton(role || 'Free');
    } catch (_) {
      localStorage.removeItem('userRole');
      showRoleButton('Free');
    }
  }

  document.addEventListener('DOMContentLoaded', function () {
    setupNavDropdowns();
    syncRoleDashboardIcon();
  });
  window.addEventListener('storage', syncRoleDashboardIcon);
  window.refreshRoleDashboardIcon = syncRoleDashboardIcon;
})();
</script>

<aside class="notification-slide-panel" id="notification-panel" aria-hidden="true">
  <div class="panel-header">
    <div>
      <h3>Trung tâm thông báo</h3>
    </div>
    <button class="close-panel-btn" type="button" data-close-notification-panel aria-label="Đóng thông báo" title="Đóng"><span data-interface-icon="x"></span></button>
  </div>
  <div class="panel-body">
    <div class="notification-panel-list" id="notification-panel-list">
      <div class="notification-panel-state">Đang tải thông báo...</div>
    </div>
  </div>
</aside>


<aside class="notification-slide-panel feedback-slide-panel" id="feedback-panel" aria-hidden="true">
  <div class="panel-header">
    <h3>Phản hồi</h3>
    <button class="close-panel-btn" type="button" data-close-feedback-panel aria-label="Đóng phản hồi"><span data-interface-icon="x"></span></button>
  </div>
  <div class="panel-body feedback-panel-body">
    <form id="travelwaiFeedbackForm" class="feedback-panel-form">
      <textarea id="travelwaiFeedbackMessage" maxlength="4000" rows="6" placeholder="Nhập phản hồi..." required></textarea>
      <div id="travelwaiFeedbackFiles" class="feedback-file-list" aria-live="polite"></div>
      <div class="feedback-panel-actions">
        <button id="travelwaiFeedbackAttachButton" class="feedback-attach-button" type="button" aria-label="Đính kèm tệp" title="Đính kèm tệp"><span data-interface-icon="paperclip"></span><span>Đính kèm</span></button>
        <button id="travelwaiFeedbackSubmitButton" class="feedback-submit-button" type="submit"><span data-interface-icon="send"></span><span>Gửi</span></button>
      </div>
      <input id="travelwaiFeedbackFileInput" type="file" multiple hidden />
    </form>
    <div class="feedback-panel-history">
      <div class="feedback-panel-history-title">Đã gửi</div>
      <div id="travelwaiFeedbackHistory" class="feedback-history-list">
        <div class="notification-panel-state">Đang tải...</div>
      </div>
    </div>
  </div>
</aside>

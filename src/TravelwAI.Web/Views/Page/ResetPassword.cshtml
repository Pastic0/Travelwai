@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đặt lại mật khẩu - TravelwAI</title>
    <link rel="icon" data-site-logo />
    <link rel="stylesheet" href="/css/login_signup_style.css?v=2026-10-10-clear-bg-v2" />
    <link rel="stylesheet" href="/css/travelwai_font.css?v=2026-10-09-mobile-scroll-fix-v1" />
    <script defer src="/script/site_branding.js?v=2026-08-05-uploaded-logo-only-v6"></script>
</head>
  <body onload="initResetPasswordPage()">
    @await Html.PartialAsync("~/Views/Shared/_TravelwAIFloatingTools.cshtml")
    <h1 class="title">
      <a class="brand-home-link" href="/landing" aria-label="Về Landing Page TravelwAI">
        <img
          data-site-logo
          alt="TravelwAI Logo"
          style="height: 50px; margin-right: 10px"
        />
        <span>TravelwAI</span>
      </a>
    </h1>
    <p class="auth-page-subtitle">Nhập mật khẩu mới để tiếp tục.</p>

    <div class="container">
      <div class="login-container password-reset-card">
        <p class="auth-kicker">Đổi mật khẩu</p>
        <h2 class="login-title">Tạo mật khẩu mới</h2>

        <form class="login-form" id="resetPasswordForm" onsubmit="handleResetPassword(event)">
          <input
            type="password"
            id="newPassword"
            placeholder="Mật khẩu mới"
            minlength="8"
            required
          />
          <input
            type="password"
            id="confirmNewPassword"
            placeholder="Nhập lại mật khẩu mới"
            minlength="8"
            required
          />
          <button type="submit" class="login-btn">Đổi mật khẩu</button>
        </form>

        <p class="auth-message" id="authMessage" hidden></p>

        <p class="login-text">
          Quay lại
          <a href="/login" class="login-link">Đăng nhập</a>
        </p>
      </div>
    </div>
    <script src="/script/accounts.js?v=2026-07-28-account-presence-v1"></script>
<script src="/script/theme_toggle.js?v=2026-07-27-notification-cleanup-v3"></script>
</body>
</html>

